Feel free to use any code in the game for your own uses; just make
sure to mention the authors and/or "The AMC Squad" in your credits.
--------------------------------------------------------------------------------
NOTES:
This does not contain code for the player character.
--------------------------------------------------------------------------------
*/

damageeventtile ALLYJAMES

action A_JAMESIDLE 0 1 5 1 11
action A_JAMESMOVE 20 4 5 1 11
action A_JAMESFIRE 0 1 5 5 3
action A_JAMESDYING 106 5 1 1 11
action A_JAMESDEAD 113 1 1 1 1
action A_JAMESJUMP 40 1 5 1 20
action A_JAMESFALL 50 1 5 1 30

move JAMESSTILL 0
move JAMESMOVE 266
move JAMESMOVESLOW 128

ai AIJAMESIDLE A_JAMESIDLE JAMESSTILL 0
ai AIJAMESMOVE A_JAMESMOVE JAMESMOVE faceplayer seekplayer
ai AIJAMESRELOAD A_JAMESMOVE JAMESMOVESLOW seekplayer
ai AIJAMESFIRE A_JAMESFIRE JAMESSTILL 0
ai AIJAMESDYING A_JAMESDYING JAMESSTILL 0
ai AIJAMESJUMPING A_JAMESJUMP JAMESMOVE jumptoplayer
ai AIJAMESFALL A_JAMESFALL JAMESMOVE seekplayer

spriteshadow ALLYJAMES
spritenvg ALLYJAMES

useractor notenemy ALLYJAMES
sizeat 26 26
geta[temp4].x temp5 seta[].x temp5
geta[temp4].y temp5 seta[].y temp5
geta[temp4].ang temp5 seta[].ang temp5
geta[temp4].pal temp6 seta[].pal temp6

getu .overhead_on temp
ife temp 2
	{
	action ZERO
	cstat 32
	}
else
	{
	cstat 32768
	}
enda

useractor notenemy ALLYJAMES
fall

state player_walkthru

ifai 0
	{
	set actor_type TYPE_ARMOURED
	seta[].htwaterzoffset 8
	spawn SHOOTME2
	spawn 12800
	strength 1500
	sizeat 23 23
	ai AIJAMESIDLE
	}

geta[].zvel temp
ifg temp 40 { ifstrength 0 break else ai AIJAMESFALL }

ifg targetlock 0 sub targetlock 1

ifg ALLY_VOICE 0
	{
	sub ALLY_VOICE 1
	ife ALLY_VOICE 1
		{
		ifrnd 96
			{
			ife ally_subt 0
				{
				qstrcpy 7501 659
				// ^1JAMES: ^0I've got your back.
				set ally_subt 32
				}
			soundonce J_GYBACK
			}
		else
		ifrnd 96
			{
			ife ally_subt 0
				{
				qstrcpy 7501 656
				// ^1JAMES: ^0Affirmative!
				set ally_subt 27
				}
			soundonce J_AFFIRM
			}
		else
		ifrnd 96
			{
			ife ally_subt 0
				{
				qstrcpy 7501 646
				// ^1JAMES: ^0On My Way
				set ally_subt 27
				}
			soundonce J_ONMYWAY
			}
		else
			{
			ife ally_subt 0
				{
				qstrcpy 7501 660
				// ^1JAMES: ^0Let's move out!
				set ally_subt 17
				}
			soundonce J_MOVEOUT
			}
		}
	}
else
ifl ALLY_VOICE 0
	{
	add ALLY_VOICE 1
	ife ALLY_VOICE -1
		{
		ifrnd 96
			{
			ife ally_subt 0
				{
				qstrcpy 7501 656
				// ^1JAMES: ^0Affirmative!
				set ally_subt 52
				}
			soundonce J_AFFIRM
			}
		else
			{
			ife ally_subt 0
				{
				qstrcpy 7501 656
				// 7501 ^1JAMES: ^0Roger.
				set ally_subt 27
				}
			soundonce J_ROGER
			}
		}
	}

ifaction A_JAMESDEAD
	{
	strength 0
	break
	}
else
ifai AIJAMESDYING
	{
	set ALLY_VOICE 0
	ifactioncount 6 { state BODY_FALL_NOISES action A_JAMESDEAD }
	}
ifai AIJAMESFIRE
	{
	state checkfortarget
	ifactioncount 3
			{
			geta[].z temp5 sub temp5 2560 seta[].z temp5
			state fronttowardstarget
			// JAMES can fire Armour-piercing laser shots as well as standard ones
			getav[my_target].actor_type temp6
				switch temp6
				default
					set HITSCAN_FIRING_SOUND LASERGUN_FIRE
					set HITSCAN_TO_SHOOT BLUELASERSHOT
				break
				case TYPE_ARMOURED_HELMET
				case TYPE_ARMOURED
				case TYPE_ROBOTIC
				case TYPE_VEHICLE
					set HITSCAN_FIRING_SOUND LASERGUN_FIRE
					set HITSCAN_TO_SHOOT REDLASERSHOT
				break
				endswitch
			state sang_enemyShootHitscanNoTargetSeek
			geta[].z temp5 add temp5 2560 seta[].z temp5
			resetactioncount
			}
	ife my_target -1
		{
		ife ALLY_ORDER 0
			{
			ifrnd 16 soundonce J_PEEK else
			ifrnd 16 soundonce J_FUCKYEAR else
			ifrnd 16 soundonce J_BINGO else
			ifrnd 16 soundonce J_NICEWORK else
			ifrnd 16 soundonce J_STEPRIGHTUP else
			ifrnd 16 soundonce J_STRETCHED else
			ifrnd 16 soundonce J_NICEWORK
			}
		ai AIJAMESIDLE
		}
	}
else
ifai AIJAMESFALL
	{
	iffloordistl 8
		{
		soundonce LAND_NORM
		ai AIJAMESMOVE
		}
	}
else
ifai AIJAMESJUMPING
	{
	soundonce SERVO
	ifactioncount 3 ai AIJAMESFALL
	}
else
ifai AIJAMESMOVE
	{
	ifactioncount 3
		{
		state npc_footsteps
		sound BIG_BOOT_STEP
		resetactioncount
		}
	ifnotmoving operate
	ifp phigher ifnotmoving ifrnd 128 ai AIJAMESJUMPING else
	ifpdistl 1024
		{
		ifphealthl 30 ifrnd 32
			{
			ife CHAR 0
				{
				ifrnd 128
					{
					ife ally_subt 0
					 ifcansee
						{
						qstrcpy 7501 5126
						// 7501 ^1JAMES: ^0I need some backup.
						set ally_subt 67
						}
					soundonce J_BACKUP
					}
					else
					{
					ife ally_subt 0
					 ifcansee
						{
						qstrcpy 7501 5127
						// 7501 ^1JAMES: ^0Oh Shit?
						set ally_subt 90
						}
					soundonce J_ANNOY1
					}
				}
				else
				ifrnd 128
					{
					ife ally_subt 0
					 ifcansee
						{
						qstrcpy 7501 5128
						// 7501 ^1JAMES: ^0YSUBOPTIMAL.
						set ally_subt 76
						}
					soundonce J_SUBOPTIMAL
					}
					else
					{
					ife ally_subt 0
					 ifcansee
						{
						qstrcpy 7501 5129
						// 7501 ^1JAMES: ^0MEdic?
						set ally_subt 89
						}
					soundonce J_WAIT
					}
			}
		ai AIJAMESIDLE
		}
	}
else
ifai AIJAMESIDLE
	{
	sleeptime 0
	state rand_lookaround
	add temp7 1
	ife FOLLOW_PLAYER 1
		{
		ifpdistg 1735
		 ifcansee
		  ifcanseetarget
		   ai AIJAMESMOVE
		}
	else
	 ifn camerasprite -1
		{
		checkactivatormotion hitag_saved
		 ife RETURN 1 move JAMESSTILL faceplayer
		checkactivatormotion lotag_saved
		 ife RETURN 1 killit
		checkactivatormotion xvel_saved
		 ife RETURN 1 killit
		}
	ifstrength 1499 ifcount 6 { addstrength 1 resetcount }
	}

state player_follow_commands

ifhitweapon
	{
	spawn BLOOD
	state actor_knockback_state
	state random_wall_jibs
	state NEWGUNEFFECTS
	ifdead
		{
		state clear_ally_death
		state rf
		ai AIJAMESDYING
		state removefollower
		ifrnd 76 spawn BLOODPOOL
		ifmultiplayer nullop else
			{
			palfrom 63 63 63 63
			set SLO_MO_SHOWOFF 70
			set FISSION_MAILED 1
			}
		}
	}

ifg SEEK_ENEMY_COUNT 0 sub SEEK_ENEMY_COUNT 1
ifg player_taunt 0 sub player_taunt 1

	ife SEEK_ENEMY_COUNT 0
	{
	ifdead break
	ifai AIJAMESRELOAD break
	state checkfortarget
	ifn my_target -1
		{
		ife player_taunt 0
			{
			ifrnd 96
				{
				ife ally_subt 0
					{
					qstrcpy 7501 643
					// 7501 ^1JAMES: ^0Incoming!
					set ally_subt 26
					}
				soundonce J_INCOMING
				}
			else
			ifrnd 96
				{
				ife ally_subt 0
					{
					qstrcpy 7501 5131
					// 7501 ^1JAMES: ^0Hostiles!
					set ally_subt 29
					}
				soundonce J_SDRAW_TAUNT1
				}
			else ifrnd 96
				{
				ife ally_subt 0
					{
					qstrcpy 7501 650
					// 7501 ^1JAMES: ^0Watch Out!
					set ally_subt 40
					}
				soundonce J_WOUT
				}
			set player_taunt 600
			}
		ai AIJAMESFIRE
		}
	set SEEK_ENEMY_COUNT 6
	}

enda
